# Copy to apps/web/.env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or your legacy "anon" key

# Server only — never prefix with NEXT_PUBLIC_. Used by /api/admin/users to
# create staff logins. Supabase → Project Settings → API Keys → Secret key
# (or the legacy "service_role" key as SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=sb_secret_xxx

# AI Copilot (server only)
ANTHROPIC_API_KEY=sk-ant-xxx
